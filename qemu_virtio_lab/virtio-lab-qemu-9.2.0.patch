+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_VIRTIO_LAB_H
+#define HW_VIRTIO_LAB_H
+#include "hw/virtio/virtio.h"
+#include "qemu/main-loop.h"
+#include "qom/object.h"
+
+#define TYPE_VIRTIO_LAB "virtio-lab-device"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOLab, VIRTIO_LAB)
+
+struct VirtIOLab {
+    VirtIODevice parent_obj;
+    VirtQueue *vq;
+    QEMUBH *bh;
+    int64_t kick_ns;
+};
+#endif
diff --git a/hw/virtio/virtio-lab-pci.c b/hw/virtio/virtio-lab-pci.c
new file mode 100644
--- /dev/null
+++ b/hw/virtio/virtio-lab-pci.c
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "hw/virtio/virtio-pci.h"
+#include "hw/qdev-properties.h"
+#include "virtio-lab.h"
+#include "lab-protocol.h"
+#include "qemu/module.h"
+
+typedef struct VirtIOLabPCI {
+    VirtIOPCIProxy parent_obj;
+    VirtIOLab vdev;
+} VirtIOLabPCI;
+
+#define TYPE_VIRTIO_LAB_PCI "virtio-lab-pci-base"
+DECLARE_INSTANCE_CHECKER(VirtIOLabPCI, VIRTIO_LAB_PCI, TYPE_VIRTIO_LAB_PCI)
+
+static void virtio_lab_pci_realize(VirtIOPCIProxy *proxy, Error **errp)
+{
+    VirtIOLabPCI *s = VIRTIO_LAB_PCI(proxy);
+    qdev_realize(DEVICE(&s->vdev), BUS(&proxy->bus), errp);
+}
+
+static void virtio_lab_pci_instance_init(Object *obj)
+{
+    VirtIOLabPCI *s = VIRTIO_LAB_PCI(obj);
+    virtio_instance_init_common(obj, &s->vdev, sizeof(s->vdev), TYPE_VIRTIO_LAB);
+}
+
+static void virtio_lab_pci_class_init(ObjectClass *klass, void *data)
+{
+    PCIDeviceClass *pc = PCI_DEVICE_CLASS(klass);
+    VIRTIO_PCI_CLASS(klass)->realize = virtio_lab_pci_realize;
+    pc->vendor_id = PCI_VENDOR_ID_REDHAT_QUMRANET;
+    pc->device_id = 0x1040 + VIRTIO_LAB_DEVICE_ID;
+    pc->revision = 1;
+    pc->class_id = PCI_CLASS_OTHERS;
+    set_bit(DEVICE_CATEGORY_MISC, DEVICE_CLASS(klass)->categories);
+}
+
+static const VirtioPCIDeviceTypeInfo virtio_lab_pci_info = {
+    .base_name = TYPE_VIRTIO_LAB_PCI,
+    .non_transitional_name = "virtio-lab-pci",
+    .instance_size = sizeof(VirtIOLabPCI),
+    .instance_init = virtio_lab_pci_instance_init,
+    .class_init = virtio_lab_pci_class_init,
+};
+
+static void virtio_lab_pci_register_types(void)
+{
+    virtio_pci_types_register(&virtio_lab_pci_info);
+}
+type_init(virtio_lab_pci_register_types)
diff --git a/hw/virtio/lab-protocol.c b/hw/virtio/lab-protocol.c
new file mode 100644
--- /dev/null
+++ b/hw/virtio/lab-protocol.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "lab-protocol.h"
+#include <string.h>
+
+static uint32_t get32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void put32(uint8_t *p, uint32_t value)
+{
+    p[0] = value;
+    p[1] = value >> 8;
+    p[2] = value >> 16;
+    p[3] = value >> 24;
+}
+
+size_t lab_respond(const uint8_t *request, size_t request_len,
+                   uint8_t *response, size_t response_capacity)
+{
+    uint32_t length = 0, status = LAB_OK;
+    if (response_capacity < LAB_HEADER_SIZE) {
+        return 0;
+    }
+    memset(response, 0, LAB_HEADER_SIZE);
+    if (request_len < LAB_HEADER_SIZE) {
+        status = LAB_BAD_REQUEST;
+    } else {
+        memcpy(response + 8, request + 8, 8);
+        length = get32(request + 4);
+        if (length > LAB_MAX_PAYLOAD || request_len != LAB_HEADER_SIZE + length ||
+            request[2] != 0 || request[3] != 0) {
+            status = LAB_BAD_REQUEST;
+        } else if (request[0] != LAB_OP_ECHO || request[1] != 0) {
+            status = LAB_UNSUPPORTED;
+        } else if (response_capacity - LAB_HEADER_SIZE < length) {
+            status = LAB_NO_SPACE;
+        }
+    }
+    if (status != LAB_OK) {
+        length = 0;
+    }
+    put32(response, status);
+    put32(response + 4, length);
+    if (length) {
+        memcpy(response + LAB_HEADER_SIZE, request + LAB_HEADER_SIZE, length);
+    }
+    return LAB_HEADER_SIZE + length;
+}
diff --git a/hw/virtio/lab-protocol.h b/hw/virtio/lab-protocol.h
new file mode 100644
--- /dev/null
+++ b/hw/virtio/lab-protocol.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef LAB_PROTOCOL_H
+#define LAB_PROTOCOL_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Local experiment only. This is NOT an OASIS-assigned device ID. */
+#define VIRTIO_LAB_DEVICE_ID 63
+#define LAB_VERSION 1
+#define LAB_MAX_PAYLOAD 4096
+#define LAB_HEADER_SIZE 16
+#define LAB_MAX_MESSAGE (LAB_HEADER_SIZE + LAB_MAX_PAYLOAD)
+#define LAB_OP_ECHO 1
+#define LAB_OK 0
+#define LAB_BAD_REQUEST 1
+#define LAB_UNSUPPORTED 2
+#define LAB_NO_SPACE 3
+
+/* LE wire format; no packed-struct dereferences or host-endian assumptions.
+ * Request:  opcode:u16, flags:u16(0), length:u32, request_id:u64, payload.
+ * Response: status:u32, length:u32, request_id:u64, payload.
+ * Returns actual bytes written; zero means no safe response header fits.
+ */
+size_t lab_respond(const uint8_t *request, size_t request_len,
+                   uint8_t *response, size_t response_capacity);
+#endif
